# Copy to .env when a PostgreSQL instance is available. Replace these placeholders.
EVALFORGE_DATABASE_URL=postgresql+asyncpg://evalforge:change-me@localhost:5432/evalforge
# SQL logging is disabled by default; SQL parameters can contain application data.
EVALFORGE_DB_ECHO=false

# Cloud authentication requires PostgreSQL and Redis; the offline runner requires neither.
# Use rediss:// for TLS. Percent-encode special characters in credentials.
EVALFORGE_REDIS_URL=redis://localhost:6379/0
EVALFORGE_REDIS_CONNECT_TIMEOUT=5
EVALFORGE_REDIS_SOCKET_TIMEOUT=5
EVALFORGE_REDIS_MAX_CONNECTIONS=20
EVALFORGE_REDIS_HEALTH_CHECK_INTERVAL=30

# Browser authentication. Origins must be explicit and must not contain a path.
# Production: use HTTPS and keep secure cookies enabled.
EVALFORGE_ALLOWED_ORIGINS=https://localhost:8000
EVALFORGE_COOKIE_SECURE=true
EVALFORGE_SESSION_TTL_SECONDS=86400
EVALFORGE_RUNNER_WS_URL=wss://localhost:8000/api/v1/runner/ws
EVALFORGE_RUNNER_AUTH_CHECK_SECONDS=5
# Local HTTP only: set origins to http://127.0.0.1:8000 and COOKIE_SECURE=false.
# Local Runner URL: ws://127.0.0.1:8000/api/v1/runner/ws (business session methods are not registered yet).
