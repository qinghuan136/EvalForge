# Copy to .env.compose at the project root. Use two independently generated
# hex strings (for example, run openssl rand -hex 32 for each value).
POSTGRES_PASSWORD=
EVALFORGE_INTERNAL_ROUTE_TOKEN=

EVALFORGE_ALLOWED_ORIGINS=https://evalforge.example.com
EVALFORGE_RUNNER_WS_URL=wss://evalforge.example.com/api/v1/runner/ws
EVALFORGE_TLS_DIR=./deploy/tls
EVALFORGE_HTTPS_BIND=0.0.0.0
EVALFORGE_HTTPS_PORT=443
